<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Product"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <EditText
            android:id="@+id/etProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Product Name"
            android:textColor="#000000"
            android:textColorHint="#777777" />
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/etBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Brand"
            android:textColor="#000000"
            android:textColorHint="#777777" />
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Price"
            android:textColor="#000000"
            android:textColorHint="#777777" />
            android:inputType="numberDecimal" />

        <TextView
            android:id="@+id/tvPurchaseDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Purchase Date: Select"
            android:textSize="16sp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp" />

        <EditText
            android:id="@+id/etWarrantyMonths"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Warranty Duration (months)"
            android:textColor="#000000"
            android:textColorHint="#777777" />
            android:inputType="number" />

        <TextView
            android:id="@+id/tvInvoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Invoice: Not selected"
            android:paddingTop="18dp"
            android:paddingBottom="18dp" />

        <Button
            android:id="@+id/btnChooseInvoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Invoice"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSaveProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Product"
            android:textAllCaps="false"
            android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
